{
  "engine": "perplexity",
  "version": "2026.10.0",
  "default_mode": "deep-research",
  "structure": "concise-query",
  "length": "concise",
  "source_filter_syntax": [
    "site:",
    "filetype:",
    "after:",
    "before:"
  ],
  "strengths": [
    "concise keyword queries",
    "source/recency operators",
    "fast search-grounded answers"
  ],
  "directives": [
    "Compress the asks to keywords",
    "Demote unverified premises",
    "Scope first-party claims with site:",
    "Add recency operators",
    "Decompose multi-entity questions",
    "Request citations"
  ],
  "notes": "Perplexity retrieves before it generates: the query string is embedded and keyword-matched first, so verbose narrative and asserted premises steer retrieval, not just phrasing. Lead with the asks, demote declaratives to a claim line, scope named orgs with site:. Hand-authored M1; renderer reworked 2026-10 to target the retrieval stage.",
  "doc_sources": [
    "https://docs.perplexity.ai",
    "https://www.perplexity.ai/hub/faq"
  ],
  "last_checked": "2026-10-01",
